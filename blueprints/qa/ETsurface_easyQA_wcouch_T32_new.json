{
  "name": "Erste einfache QA Sequenz für ET Surface System der Tirol Kliniken, mit Couchauslenkung.",
  "heatingpads": "32",
  "meas_couch_type": "multi angle",
  "sequence": [
    {
      "type": "checkpoint",
      "msg": "Sind alle Achsen gehomed und das Phantom korrekt montiert?"
    },

    {
      "type": "checkpoint",
      "msg": "Ist die Couch Rotation auf 0° und Heating Pads auf 32°C?"
    },

    {
      "type": "heat",
      "a": 32.0,
      "b": 32.0,
      "wait_steady": true
    },

    {
      "type": "log_checkpoint",
      "key": "raumlicht_aus",
      "mode": "yesno",
      "msg": "Raumlicht im Behandlungsraum aus? (Lichtsettings müssen bei JEDER Messung gleich sein!)"
    },

    {
      "type": "logging",
      "action": "start",
      "prefix": "ETsurface_easyQA_wcouch_T32"
    },
    {
      "type": "qa_input",
      "mode": "sphere_detection",
      "point_id": "0_Referenz",
      "msg": "Bitte Sphere Detection durchführen und initiales Isozentrum (Winston-Lutz Pointer) eingeben."
    },

    {
      "type": "checkpoint",
      "msg": "Surface Tracking aktivieren."
    },

    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 5.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": -10.0, "speed": 20.0 },
    { "type": "move", "V": 20.0, "speed": 20.0 },
    { "type": "move", "R": 1.0, "speed": 2.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": -5.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": -10.0, "speed": 20.0 },

    {
      "type": "qa_input",
      "mode": "sphere_detection",
      "point_id": "1_endposition_d1",
      "msg": "Bitte Sphere Detection durchführen und Verschübe eingeben."
    },


    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "move", "V": 0.0, "speed": 20.0 },
    { "type": "move", "R": 0.0, "speed": 2.0 },
    { "type": "delay", "time": 2.0 },

    {
      "type": "qa_input",
      "mode": "sphere_detection",
      "point_id": "2_zeroposition",
      "msg": "Bitte Sphere Detection durchführen und Verschübe eingeben."
    },

    {
      "type": "checkpoint",
      "msg": "Surface Tracking wieder aktiv?"
    },

    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 5.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": -30, "speed": 20.0 },
    { "type": "move", "V": 50, "speed": 20.0 },
    { "type": "move", "R": 2.0, "speed": 2.0 },
    { "type": "delay", "time": 4.0 },
    { "type": "move", "H": -25.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": -30.0, "speed": 20.0 },

    {
      "type": "qa_input",
      "mode": "sphere_detection",
      "point_id": "3_endposition_d2",
      "msg": "Bitte Sphere Detection durchführen und Verschübe eingeben."
    },


    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "move", "V": 0.0, "speed": 20.0 },
    { "type": "move", "R": 0.0, "speed": 2.0 },
    { "type": "delay", "time": 2.0 },


    {
      "type": "qa_input",
      "mode": "sphere_detection",
      "point_id": "4_zeroposition",
      "msg": "Bitte Sphere Detection durchführen und Verschübe eingeben."
    },

    {
      "type": "checkpoint",
      "msg": "Bitte Couch auf -90° (links Ausschwenken ? ;-)). 'Nein' für Abbruch."
    },

    { "type": "move", "R": 90.0, "speed": 20.0 },

    {
      "type": "checkpoint",
      "msg": "Phantomausrichtung bitte grob kontrollieren. 'Nein' für Abbruch."
    },

    {
      "type": "qa_input",
      "mode": "sphere_detection",
      "point_id": "5_referenz_couch-90",
      "msg": "Bitte Sphere Detection durchführen und Verschübe eingeben."
    },

    {
      "type": "checkpoint",
      "msg": "Surface Tracking aktivieren."
    },

    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 5.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": -10.0, "speed": 20.0 },
    { "type": "move", "V": 20.0, "speed": 20.0 },
    { "type": "move", "R": 91.0, "speed": 2.0 },
    { "type": "delay", "time": 4.0 },
    { "type": "move", "H": -5.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": -10.0, "speed": 20.0 },

    {
      "type": "qa_input",
      "mode": "sphere_detection",
      "point_id": "6_endposition_d1_couch-90",
      "msg": "Bitte Sphere Detection durchführen und Verschübe eingeben."
    },


    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "move", "V": 0.0, "speed": 20.0 },
    { "type": "move", "R": 90.0, "speed": 2.0 },
    { "type": "delay", "time": 2.0 },

    {
      "type": "qa_input",
      "mode": "sphere_detection",
      "point_id": "7_zeroposition_couch-90",
      "msg": "Bitte Sphere Detection durchführen und Verschübe eingeben."
    },

    {
      "type": "checkpoint",
      "msg": "Surface Tracking wieder aktiv?"
    },

    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 5.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": -30, "speed": 20.0 },
    { "type": "move", "V": 50, "speed": 20.0 },
    { "type": "move", "R": 92.0, "speed": 2.0 },
    { "type": "delay", "time": 4.0 },
    { "type": "move", "H": -25.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": -30.0, "speed": 20.0 },

    {
      "type": "qa_input",
      "mode": "sphere_detection",
      "point_id": "8_endposition_d2_couch-90",
      "msg": "Bitte Sphere Detection durchführen und Verschübe eingeben."
    },


    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "move", "V": 0.0, "speed": 20.0 },
    { "type": "move", "R": 90.0, "speed": 2.0 },
    { "type": "delay", "time": 2.0 },


    {
      "type": "qa_input",
      "mode": "sphere_detection",
      "point_id": "9_zeroposition_couch-90",
      "msg": "Bitte Sphere Detection durchführen und Verschübe eingeben."
    },

    {
      "type": "log_checkpoint",
      "key": "tracking_qualitaet",
      "mode": "text",
      "msg": "Tracking-Qualität / Auffälligkeiten (optional, Freitext):"
    },

    {
      "type": "logging",
      "action": "stop"
    },

    {
      "type": "checkpoint",
      "msg": "Messung wurde beendet."
    }

  ]
}