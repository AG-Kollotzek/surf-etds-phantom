{
  "name": "Erste einfache QA Sequenz für ET Surface System der Tirol Kliniken",
  "sequence": [
    {
      "type": "checkpoint",
      "msg": "Sind alle Achsen gehomed und das Phantom korrekt montiert?"
    },
    {
      "type": "checkpoint",
      "msg": "Ist die Couch Rotation auf 0° und Heating Pads auf RT? - Logging wird nach dem ersten XRAY gestartet."
    },

    {
      "type": "logging",
      "action": "start",
      "prefix": "ETsurface_easyQA"
    },
    {
      "type": "qa_input",
      "mode": "sphere_detection",
      "point_id": "0_Referenz",
      "msg": "Bitte Sphere Detection durchführen und initiales Isozentrum (Winston-Lutz Pointer) eingeben."
    },

    {
      "type": "checkpoint",
      "msg": "Surface Tracking aktivieren."
    },

    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 5.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": -10.0, "speed": 20.0 },
    { "type": "move", "V": 20.0, "speed": 20.0 },
    { "type": "move", "R": 1.0, "speed": 2.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": -5.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": -10.0, "speed": 20.0 },

    {
      "type": "qa_input",
      "mode": "sphere_detection",
      "point_id": "1_minVerschub",
      "msg": "Bitte Sphere Detection durchführen und Verschübe eingeben."
    },


    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "move", "V": 0.0, "speed": 20.0 },
    { "type": "move", "R": 0.0, "speed": 2.0 },
    { "type": "delay", "time": 2.0 },

    {
      "type": "qa_input",
      "mode": "sphere_detection",
      "point_id": "2_zeroposition",
      "msg": "Bitte Sphere Detection durchführen und Verschübe eingeben."
    },

    {
      "type": "checkpoint",
      "msg": "Surface Tracking wieder aktiv?"
    },

    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 5.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": -30, "speed": 20.0 },
    { "type": "move", "V": 50, "speed": 20.0 },
    { "type": "move", "R": 2.0, "speed": 2.0 },
    { "type": "delay", "time": 4.0 },
    { "type": "move", "H": -25.0, "speed": 20.0 },
    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": -30.0, "speed": 20.0 },

    {
      "type": "qa_input",
      "mode": "sphere_detection",
      "point_id": "3_MaxVerschub",
      "msg": "Bitte Sphere Detection durchführen und Verschübe eingeben."
    },


    { "type": "delay", "time": 2.0 },
    { "type": "move", "H": 0.0, "speed": 20.0 },
    { "type": "move", "V": 0.0, "speed": 20.0 },
    { "type": "move", "R": 0.0, "speed": 2.0 },
    { "type": "delay", "time": 2.0 },


    {
      "type": "qa_input",
      "mode": "sphere_detection",
      "point_id": "4_zeroposition",
      "msg": "Bitte Sphere Detection durchführen und Verschübe eingeben."
    },

    {
      "type": "logging",
      "action": "stop"
    },

    {
      "type": "checkpoint",
      "msg": "Messung wurde beendet."
    }

  ]
}